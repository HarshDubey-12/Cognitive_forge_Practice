   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "066bf299",
   "metadata": {},
   "outputs": [],
   "source": [
    "np.random.seed(0)\n",
    "\n",
    "process = np.random.normal(50,2,1000)\n",
    "USL = 55\n",
    "LSL = 45\n",
    "\n",
    "mean = np.mean(process)\n",
    "std = np.std(process)\n",
    "\n",
    "Cp = (USL-LSL)/(6*std)\n",
    "Cpk = min((USL-mean)/(3*std),(mean-LSL)/(3*std))\n",
    "\n",
    "Cp, Cpk"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c54095b0",
   "metadata": {},
   "outputs": [],
   "source": [
    "print('Cp:', Cp, 'Cpk:', Cpk)"
   ]
  }
 ],

   "source": [
    "import numpy as np\n",
    "from scipy.stats import norm"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "c54c8227-76d3-4991-a8ba-18eb7aacc85a",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "(0.9939041461123779, 0.3202695356659788)"
      ]
     },
     "execution_count": 2,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "np.random.seed(0)\n",
    "sample = np.random.normal(loc=5, scale=2, size=50)\n",
    "\n",
    "mu0 = 5\n",
    "sigma = 2\n",
    "z = (np.mean(sample) - mu0) / (sigma/np.sqrt(len(sample)))\n",
    "p_value = 2 * (1 - norm.cdf(abs(z)))\n",
    "z, p_value"
   ]
  },

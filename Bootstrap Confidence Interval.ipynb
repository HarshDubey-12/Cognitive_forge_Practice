   ],
   "source": [
    "data = np.random.normal(10,2,100)\n",
    "\n",
    "boot_means = []\n",
    "for _ in range(1000):\n",
    "    sample = np.random.choice(data, size=len(data), replace=True)\n",
    "    boot_means.append(np.mean(sample))\n",
    "\n",
    "np.percentile(boot_means, [2.5,97.5])"
   ]
  },

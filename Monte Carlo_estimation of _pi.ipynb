   "source": [
    "n = 1000000\n",
    "x = np.random.uniform(-1,1,n)\n",
    "y = np.random.uniform(-1,1,n)\n",
    "\n",
    "inside = np.sum(x**2 + y**2 <= 1)\n",
    "pi_estimate = 4 * inside / n\n",
    "pi_estimate"
   ]

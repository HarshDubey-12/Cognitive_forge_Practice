   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a0bebea3",
   "metadata": {},
   "outputs": [],
   "source": [
    "P = np.array([[0.9,0.1],\n",
    "              [0.4,0.6]])\n",
    "\n",
    "state = 0\n",
    "counts = [0,0]\n",
    "\n",
    "for _ in range(100000):\n",
    "    state = np.random.choice([0,1], p=P[state])\n",
    "    counts[state]+=1\n",
    "\n",
    "np.array(counts)/sum(counts)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,

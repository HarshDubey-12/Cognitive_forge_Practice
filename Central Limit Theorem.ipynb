   "id": "672267fb-9aa9-4d9b-9446-6fc2a11be474",
   "metadata": {},
   "outputs": [],
   "source": [
    "samples = [np.mean(np.random.exponential(scale=2, size=50)) for _ in range(10000)]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "b3d90161-89dc-45df-a411-995c9e14b9c8",

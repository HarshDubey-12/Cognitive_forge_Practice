      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.hist(samples, bins=50, density=True)\n",
    "plt.title(\"CLT: Distribution of Sample Means\")\n",
    "plt.show()"
